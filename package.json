{
  "name": "clubsync",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "keys:vapid": "node scripts/generate-vapid-keys.mjs",
    "db:push": "./scripts/apply-migrations.sh",
    "db:verify": "./scripts/verify-local.sh",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "club:provision": "node --env-file=.env.local scripts/provision-club.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.4",
    "next": "16.4.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
