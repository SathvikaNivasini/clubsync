# ---------------------------------------------------------------------------
# ClubSync environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase: required -----------------------------------------------------
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The Postgres schema the migrations created. ClubSync keeps its tables out of
# `public` so it can share a Supabase project without colliding with another
# app. This schema MUST also be listed under
#   Project Settings -> API -> Exposed schemas
# or PostgREST will not serve it and every query returns a schema error.
NEXT_PUBLIC_SUPABASE_SCHEMA=clubsync

# Project Settings -> API Keys -> anon / publishable key.
# Safe to expose: it is sent to browsers and every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Project Settings -> API Keys -> service_role / secret key.
# SERVER ONLY. It bypasses Row Level Security.
#   * Never add the NEXT_PUBLIC_ prefix to this.
#   * Never reference it from a "use client" file.
#   * lib/supabase/admin.ts imports "server-only" so the build fails if it ever
#     ends up in a client bundle.
# Used for exactly three things: creating pseudonymous accounts at sign-up,
# resetting a password from a recovery phrase, and reading push subscriptions
# to fan a notification out.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Web Push: optional -----------------------------------------------------
# Generate with:  node scripts/generate-vapid-keys.mjs
# Without these, push is disabled and the UI says so. The in-app notification
# centre still works in full.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Meeting reminders: optional --------------------------------------------
# Shared secret for POST /api/push/reminders, which an external scheduler calls
# (Vercel Cron, a GitHub Action, or pg_cron). Without it reminders are disabled;
# notifications for scheduling, rescheduling and cancelling still work.
CRON_SECRET=
